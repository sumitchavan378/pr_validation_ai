# Reference for variables you can set in the GitHub Actions workflow `env` block.
# Do not commit real secrets.

OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_APP_NAME=VirtualReviewBoard
OPENAI_MODEL=gpt-4o-mini

READINESS_TOTAL_CHECKS=20
HIGH_ISSUE_YELLOW_THRESHOLD=3
MAX_DIFF_CHARS=120000
MAX_FILE_CONTENT_CHARS=80000
ENABLE_GITHUB_CHECK_RUN=true
LOG_LEVEL=INFO
