# Reference for variables you can set in the GitHub Actions workflow `env` block.
# Do not commit real secrets.

# API key from https://aistudio.google.com/ — also accepted: GEMINI_API_KEY
GOOGLE_API_KEY=
GITHUB_TOKEN=
GITHUB_APP_NAME=VirtualReviewBoard
GEMINI_MODEL=gemini-3.5-flash

READINESS_TOTAL_CHECKS=20
HIGH_ISSUE_YELLOW_THRESHOLD=3
MAX_DIFF_CHARS=120000
MAX_FILE_CONTENT_CHARS=80000
INCLUDE_MINOR_IN_COMMENT=false
MAX_HIGH_ISSUES_IN_COMMENT=5
MAX_COMMENT_CHARS=20000
ENABLE_GITHUB_CHECK_RUN=true
LOG_LEVEL=INFO
